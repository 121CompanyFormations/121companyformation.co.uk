{
  "name": "121-efiling-redesign",
  "version": "1.0.0",
  "private": true,
  "description": "121 Company Formation eFiling redesign – static preview",
  "scripts": {
    "build:dist": "node scripts/build-dist.mjs",
    "build:site": "node scripts/sync-from-live.mjs --site-only",
